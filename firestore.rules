rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'ezemariaezemaria77@gmail.com',
          'xeranraptor@gmail.com'
        ];
    }

    match /users/{userId} {
      // Admins may review user records. Users retain access only to their own record.
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Admins may change billing/trust fields. A normal user may only change
      // the explicitly self-editable profile/preferences fields below.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'phone', 'onboardingComplete',
          'country', 'timezone', 'defaultMarket',
          'twoFactorEnabled', 'loginAlerts', 'notifications'
        ])
      );

      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /activity/{activityId} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update, delete: if false;
      }

      match /receipts/{receiptId} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
        allow create: if isSignedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update: if isAdmin();
        allow delete: if false;
      }
    }

    match /bot_signals/{signalId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Admin-only audit trail. It is intentionally separate from user activity.
    match /admin_audit/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read their own profile and create it at signup.
    // Updates are restricted to a small set of self-editable fields —
    // subscriptionStatus, trialEndDate, and accountId must NOT be
    // client-writable, or any signed-in user could open dev tools and
    // approve their own subscription. onboardingComplete IS safe to let
    // the user set themselves — it only unlocks pages they already have
    // legitimate access to, it doesn't touch billing/trust fields.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fullName', 'phone', 'onboardingComplete']);
      allow delete: if false;
    }
  }
}
